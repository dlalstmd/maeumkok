 "motion_rules": "「은은한 움직임」 사용자 토글, 기본 ON. OS 동작 줄이기(MediaQuery.disableAnimations / iOS Reduce Motion / Android 애니메이션 배율 0) 켜짐 → 정지 프레임, 배터리 절약 모드·백그라운드 → 정지. 30fps 상한, 입자 최대 20개.",
 "default_background": {
  "type": "tod",
  "id": "tod_gradient",
  "reason": "가장 차분한 세트(무채색 세트는 빈 느낌), 새벽·낮·노을·밤 그라데이션"
 },
