rules_version = '2';
// 마음콕 보안 규칙. 커플 연결은 클라이언트 트랜잭션 + 규칙 검증(Blaze 전환 후 Cloud Functions로 이전 가능).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc(u) { return get(/databases/$(database)/documents/users/$(u)); }
    function hasNoCouple(u) {
      return !exists(/databases/$(database)/documents/users/$(u))
        || userDoc(u).data.get('coupleId', null) == null;
    }
    function coupleOf(c) { return get(/databases/$(database)/documents/couples/$(c)); }
    function isMember(c) {
      return signedIn() && exists(/databases/$(database)/documents/couples/$(c))
        && uid() in coupleOf(c).data.members;
    }

    // 개인 필드(커플 공유 아님): headerText, startDate, dDayFormat, countStartAsDayOne, avatar, fcmTokens
    function validPersonal(d) {
      return (d.get('headerText', null) == null || (d.headerText is string && d.headerText.size() <= 20))
        && (d.get('startDate', null) == null || (d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (d.get('dDayFormat', null) == null || d.dDayFormat in ['dPlus', 'days', 'monthsDays', 'hidden'])
        && (d.get('countStartAsDayOne', null) == null || d.countStartAsDayOne is bool)
        && (d.get('avatar', null) == null || (d.avatar is map && d.avatar.size() <= 10))
        && (d.get('avatarAdjust', null) == null || (d.avatarAdjust is map && d.avatarAdjust.size() <= 10))
        && (d.get('prefs', null) == null || (d.prefs is map && d.prefs.size() <= 10
            && (d.prefs.get('touchHaptics', true) is bool)))
        && (d.get('background', null) == null || (d.background is map && d.background.size() <= 8))
        && (d.get('fcmTokens', null) == null || (d.fcmTokens is list && d.fcmTokens.size() <= 10));
    }

    match /users/{userId} {
      // 본인, 또는 같은 커플 상대
      allow read: if signedIn() && (uid() == userId
        || (resource.data.get('coupleId', null) != null && isMember(resource.data.coupleId)));
      allow create: if signedIn() && uid() == userId
        && request.resource.data.get('coupleId', null) == null;
      // coupleId 외 필드는 본인만 수정
      allow update: if signedIn() && uid() == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coupleId', 'uid'])
        && validPersonal(request.resource.data);
      // 커플 연결 확정 시: 초대 주인이 자신+상대의 coupleId를 같은 배치로 설정
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId'])
        && resource.data.get('coupleId', null) == null
        && request.resource.data.coupleId is string
        && getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.members.hasAll([uid(), userId]);
      allow delete: if false;

      // 개인 설정: 즐겨찾기(최대 24), 최근 보낸 감정(최대 12). 본인만.
      match /prefs/emotionFavorites {
        allow read: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['order', 'updatedAt'])
          && request.resource.data.order is list
          && request.resource.data.order.size() <= 24;
        allow delete: if signedIn() && uid() == userId;
      }
      match /prefs/recentEmotions {
        allow read: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['items'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 12;
        allow delete: if signedIn() && uid() == userId;
      }
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      // 1) A가 코드 생성 (24h)
      allow create: if signedIn() && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['ownerUid', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.ownerUid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(23, 'h')
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && hasNoCouple(uid());
      // 만료/종료된 코드는 새 주인이 덮어쓰기 가능
      allow update: if signedIn()
        && (resource.data.expiresAt < request.time || resource.data.status == 'cancelled')
        && request.resource.data.keys().hasOnly(['ownerUid', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.ownerUid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(23, 'h')
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && hasNoCouple(uid());
      // 2) B가 코드 입력 → claimed (B의 확인)
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && resource.data.ownerUid != uid()
        && hasNoCouple(uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt'])
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == uid()
        && request.resource.data.claimedAt == request.time;
      // 3) A가 수락 → confirmed + 커플 생성 (A의 확인)
      allow update: if signedIn()
        && resource.data.status == 'claimed'
        && resource.data.expiresAt > request.time
        && resource.data.ownerUid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'coupleId'])
        && request.resource.data.status == 'confirmed'
        && existsAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId));
      // A가 거절/취소, 또는 B가 철회
      allow update: if signedIn()
        && resource.data.status in ['pending', 'claimed']
        && (resource.data.ownerUid == uid() || resource.data.get('claimedBy', null) == uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow read: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'inviteCode', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.members.size() == 2
        && hasNoCouple(request.resource.data.members[0])
        && hasNoCouple(request.resource.data.members[1])
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.ownerUid == uid()
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.status == 'claimed'
        && request.resource.data.members == [uid(),
             get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.claimedBy]
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.coupleId == coupleId;
      allow update, delete: if false;

      match /emotions/{emotionId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['senderUid', 'emotionId', 'createdAt', 'readAt', 'count', 'snapshot'])
          && (request.resource.data.get('count', 1) is int
              && request.resource.data.get('count', 1) >= 1
              && request.resource.data.get('count', 1) <= 99)
          && (request.resource.data.get('snapshot', null) == null
              || (request.resource.data.snapshot is map && request.resource.data.snapshot.size() <= 12))
          && request.resource.data.senderUid == uid()
          && request.resource.data.emotionId is string
          && request.resource.data.emotionId.size() <= 40
          && request.resource.data.createdAt == request.time
          && request.resource.data.get('readAt', null) == null;
        // 읽음 표시: 받는 쪽만 readAt 갱신
        allow update: if isMember(coupleId)
          && resource.data.senderUid != uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        // 연타 병합: 보낸 사람이 10초 안에 count만 증가(최대 99)
        allow update: if isMember(coupleId)
          && resource.data.senderUid == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count > resource.data.get('count', 1)
          && request.resource.data.count <= 99
          && request.time < resource.data.createdAt + duration.value(10, 's');
        allow delete: if false;
      }

      // 우리 감정(커플 커스텀). 삭제는 soft delete(deleted=true)만.
      // 활성 개수는 counters/customEmotions.n 으로 같은 배치에서 ±1 (최대 30).
      function counterPath() {
        return /databases/$(database)/documents/couples/$(coupleId)/counters/customEmotions;
      }
      function counterNow() {
        return exists(counterPath()) ? get(counterPath()).data.n : 0;
      }
      function rxOk(r, i) {
        return r.size() <= i || (r[i] is string && r[i].size() >= 1 && r[i].size() <= 12);
      }
      function validCustom(d) {
        return d.label is string && d.label.size() >= 1 && d.label.size() <= 6
          && d.glyphType in ['icon', 'emoji']
          && (d.get('icon', null) == null || (d.icon is string && d.icon.size() <= 40))
          && (d.get('emoji', null) == null || (d.emoji is string && d.emoji.size() <= 16))
          && d.category in ['mood', 'body', 'want', 'love']
          && d.vibrationName in ['short', 'double', 'heart', 'buzz', 'slow', 'long', 'soft', 'triple']
          && d.animationKey in ['joy_bounce', 'sway', 'rush', 'drool', 'heart_pop', 'shiver', 'doze', 'cheer']
          && d.reactions is list && d.reactions.size() <= 3
          && rxOk(d.reactions, 0) && rxOk(d.reactions, 1) && rxOk(d.reactions, 2);
      }
      match /counters/customEmotions {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n == 1;
        allow update: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n is int
          && request.resource.data.n >= 0 && request.resource.data.n <= 30
          && (request.resource.data.n == resource.data.n + 1
              || request.resource.data.n == resource.data.n - 1);
        allow delete: if false;
      }
      match /customEmotions/{customId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && customId.matches('^custom_[a-z0-9]{8,40}$')
          && request.resource.data.keys().hasOnly(['id', 'label', 'glyphType', 'icon', 'emoji',
               'category', 'vibrationName', 'animationKey', 'reactions', 'createdBy',
               'createdAt', 'updatedAt', 'deleted'])
          && request.resource.data.id == customId
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.deleted == false
          && validCustom(request.resource.data)
          && counterNow() < 30
          && getAfter(counterPath()).data.n == counterNow() + 1;
        // 편집(둘 다 가능, 삭제된 감정은 불가)
        allow update: if isMember(coupleId)
          && resource.data.deleted == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'glyphType',
               'icon', 'emoji', 'category', 'vibrationName', 'animationKey', 'reactions', 'updatedAt'])
          && request.resource.data.deleted == false
          && validCustom(request.resource.data);
        // soft delete
        allow update: if isMember(coupleId)
          && resource.data.deleted == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'updatedAt'])
          && request.resource.data.deleted == true
          && getAfter(counterPath()).data.n == counterNow() - 1;
        allow delete: if false;
      }

      // 서버 전용(Cloud Functions 레이트 리밋 상태)
      match /meta/{doc} {
        allow read, write: if false;
      }

      match /reactions/{reactionId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['senderUid', 'emotionDocId', 'reactionId', 'createdAt'])
          && request.resource.data.senderUid == uid()
          && request.resource.data.emotionDocId is string
          && request.resource.data.reactionId is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
